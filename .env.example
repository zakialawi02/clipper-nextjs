# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# NextAuth configuration
AUTH_SECRET=""

# PostgreSQL database connection string used by Prisma and NextAuth
DATABASE_URL="postgresql://USER:***@HOST:5432/DATABASE"

# Redis connections
REDIS_URL="redis://localhost:6379"
BULLMQ_REDIS_URL="redis://localhost:6380"


# Next Auth Providers
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""


# AI Provider (OpenAI-compatible)
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="sk-..."

# Cloudflare R2
R2_ENDPOINT="https://345652e3b303fd5328ce09ac465d35cc.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="clipper"
R2_PUBLIC_URL="https://pub-ee4f3705ba9f4400ac002f00b8abab48.r2.dev"

# Polar.sh
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# Sentry
SENTRY_DSN=""

# Sentry source map upload (production only, optional)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
